<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Helm talks to TVs on the LAN over plain ADB, and to its own loopback
         server, so cleartext is needed. APK downloads use HTTPS via Tls.kt,
         which also supplies current root certificates on older Android. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
