<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Helm talks to TVs on the LAN over plain ADB, and to its own loopback
         server, so cleartext is needed. Downloads still use HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Let's Encrypt's root. Android only trusts it from 7.1.1 on;
                 bundling it keeps APK downloads from Let's Encrypt-hosted
                 mirrors working on Android 7.0 devices too. -->
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
</network-security-config>
